# Hugging Face token (required to download gated models such as meta-llama/Llama-3.1-8B-Instruct)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases (optional for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=talk-to-me-in-your-language

# Custom cache directories (recommended for large models & datasets)
HF_HOME=./cache/huggingface
TRANSFORMERS_CACHE=./cache/transformers

# Compute / GPU setup
CUDA_VISIBLE_DEVICES=0

